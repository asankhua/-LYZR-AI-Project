# Root env file for Architect 2.0. Copy to .env in this same folder.
# Do not create env files in subfolders.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to off to review the app as a guest. Google, GitHub, and magic link stay disabled.
# ARCHITECT_AUTH=off

# Optional. Not read by the app. Used by GitHub Actions later.
# SUPABASE_ACCESS_TOKEN=

# Optional. Sent as x-keepalive-token by the daily database keep-alive job.
# KEEPALIVE_TOKEN=

# Optional. Skip these if rate limiting stays in Postgres.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
